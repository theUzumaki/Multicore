
universe = parallel

executable = openmpiscript.sh

arguments = align_m_c 10 0.1 0.3 0.35 1 5 5 3 5 5 5 2 M 609823

should_transfer_files = YES

transfer_input_files = align_m_c

when_to_transfer_output = on_exit_or_evict

output = out.$(NODE)
error = err.$(NODE)
log = log

machine_count = 1
request_cpus = 2

getenv = True

request_gpus = 1

queue
