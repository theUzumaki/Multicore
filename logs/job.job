
universe = parallel

executable = openmpiscript.sh

arguments = align_m_c 10000 0.35 0.2 0.25 0 0 0 10000 9000 9000 50 100 M 4353435

should_transfer_files = YES

transfer_input_files = align_m_c

when_to_transfer_output = on_exit_or_evict

output = out.$(NODE)
error = err.$(NODE)
log = log

machine_count = 8
request_cpus = 1

getenv = True

request_gpus = 1

queue
