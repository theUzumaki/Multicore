
universe = parallel

executable = openmpiscript.sh

arguments = align_seq 10000 0.35 0.2 0.25 0 0 0 10000 9000 9000 50 100 M 4353435

should_transfer_files = YES

transfer_input_files = align_seq

when_to_transfer_output = on_exit_or_evict

output = out.$(NODE)
error = err.$(NODE)
log = log

machine_count = 1
request_cpus = 2

getenv = True

request_gpus = 2

queue
